diff --git a/src/ui/imgui_drawer.cpp b/src/ui/imgui_drawer.cpp
index f270f3c..1516d66 100644
--- a/src/ui/imgui_drawer.cpp
+++ b/src/ui/imgui_drawer.cpp
@@ -439,7 +439,16 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
   if (!dialogs_.empty()) {
     // Repaint (and handle input) continuously if still active. In detached mode
     // there is no presenter; the app drives repaint via its own present loop.
-    if (presenter_) {
+    // Idle passive dialogs (see ImGuiDialog::WantsContinuousRepaint) don't
+    // require continuous repainting - they are redrawn with guest frames.
+    bool continuous_repaint = false;
+    for (const ImGuiDialog* dialog : dialogs_) {
+      if (dialog->WantsContinuousRepaint()) {
+        continuous_repaint = true;
+        break;
+      }
+    }
+    if (presenter_ && continuous_repaint) {
       presenter_->RequestUIPaintFromUIThread();
     }
   }
