diff --git a/include/rex/ui/imgui_dialog.h b/include/rex/ui/imgui_dialog.h
index a7ab6b3..62b7d6c 100644
--- a/include/rex/ui/imgui_dialog.h
+++ b/include/rex/ui/imgui_dialog.h
@@ -52,6 +52,15 @@ class ImGuiDialog {
   virtual void OnClose() {}
   virtual void OnDraw(ImGuiIO& io) { (void)io; }
 
+ public:
+  // Whether the drawer must keep repainting the UI continuously (at the host
+  // UI tick rate) while this dialog exists. Dialogs that only show transient
+  // content, such as notifications, return false while idle so that an idle
+  // dialog does not make the presenter repaint and present at the monitor
+  // refresh rate when only the guest output changes. Guest output updates still
+  // repaint the UI, so such dialogs are still drawn on every guest frame.
+  virtual bool WantsContinuousRepaint() const { return true; }
+
  private:
   ImGuiDrawer* imgui_drawer_ = nullptr;
   bool has_close_pending_ = false;
