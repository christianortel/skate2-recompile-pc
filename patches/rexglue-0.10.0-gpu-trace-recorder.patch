+#include <algorithm>
+#include <cstring>
+#include <system_error>
+
+#include <rex/graphics/trace_writer.h>
+
+#include <rex/filesystem.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/version.h>
+
+namespace rex::graphics {
+
+namespace {
+
+// Size of the guest physical address space that base_ptr values refer to.
+constexpr uint32_t kPhysicalMemorySize = 0x20000000;
+
+// Most commands are small (packets are often a few dwords), buffer them.
+constexpr size_t kFileBufferSize = size_t(1) << 20;
+
+// Commands with padding are written as whole structures, zero the padding so
+// the output is deterministic.
+template <typename T>
+T MakeCommand(TraceCommandType type) {
+  T cmd;
+  std::memset(&cmd, 0, sizeof(cmd));
+  cmd.type = type;
+  return cmd;
+}
+
+}  // namespace
+
+TraceWriter::TraceWriter(uint8_t* membase) : membase_(membase) {}
+
+TraceWriter::~TraceWriter() {
+  Close();
+}
+
+bool TraceWriter::Open(const std::filesystem::path& path, uint32_t title_id) {
+  Close();
+
+  std::error_code error_code;
+  std::filesystem::path absolute_path = std::filesystem::absolute(path, error_code);
+  if (error_code) {
+    absolute_path = path;
+  }
+  if (absolute_path.has_parent_path()) {
+    std::filesystem::create_directories(absolute_path.parent_path(), error_code);
+  }
+
+  file_ = rex::filesystem::OpenFile(absolute_path, "wb");
+  if (!file_) {
+    REXGPU_ERROR("TraceWriter: Failed to open trace file: {}",
+                 rex::path_to_utf8(absolute_path));
+    return false;
+  }
+  std::setvbuf(file_, nullptr, _IOFBF, kFileBufferSize);
+  path_ = absolute_path;
+
+  // Write header first. Must be at the top of the file.
+  TraceHeader header;
+  std::memset(&header, 0, sizeof(header));
+  header.version = kTraceFormatVersion;
+  // Not a commit hash, identifies the recording runtime instead.
+  static const char kRecorderName[] = "rexglue " REXGLUE_VERSION_STRING;
+  std::memcpy(header.build_commit_sha, kRecorderName,
+              std::min(sizeof(header.build_commit_sha), sizeof(kRecorderName) - 1));
+  header.title_id = title_id;
+  Write(&header, sizeof(header));
+  return true;
+}
+
+void TraceWriter::Flush() {
+  if (file_) {
+    std::fflush(file_);
+  }
+}
+
+bool TraceWriter::Close() {
+  if (!file_) {
+    return true;
+  }
+  bool succeeded = std::ferror(file_) == 0;
+  if (std::fclose(file_) != 0) {
+    succeeded = false;
+  }
+  file_ = nullptr;
+  if (!succeeded) {
+    REXGPU_ERROR("TraceWriter: Failed to write trace file {}, the trace is incomplete",
+                 rex::path_to_utf8(path_));
+  }
+  return succeeded;
+}
+
+void TraceWriter::Write(const void* data, size_t size) {
+  if (size) {
+    std::fwrite(data, 1, size, file_);
+  }
+}
+
+void TraceWriter::WriteTypeOnlyCommand(TraceCommandType type) {
+  // PrimaryBufferEnd, IndirectBufferEnd and PacketEnd consist of the type only.
+  static_assert(sizeof(PrimaryBufferEndCommand) == sizeof(TraceCommandType));
+  static_assert(sizeof(IndirectBufferEndCommand) == sizeof(TraceCommandType));
+  static_assert(sizeof(PacketEndCommand) == sizeof(TraceCommandType));
+  Write(&type, sizeof(type));
+}
+
+void TraceWriter::WriteBufferStartCommand(TraceCommandType type, uint32_t base_ptr) {
+  // The buffer contents are recorded as packets, not as part of this command,
+  // so the count of trailing dwords is 0.
+  static_assert(sizeof(PrimaryBufferStartCommand) == sizeof(IndirectBufferStartCommand));
+  auto cmd = MakeCommand<PrimaryBufferStartCommand>(type);
+  cmd.base_ptr = base_ptr;
+  cmd.count = 0;
+  Write(&cmd, sizeof(cmd));
+}
+
+void TraceWriter::WritePacketStartCommand(uint32_t base_ptr, const uint8_t* ring,
+                                          uint32_t ring_capacity, uint32_t offset,
+                                          uint32_t dword_count) {
+  if (offset >= ring_capacity) {
+    offset = 0;
+  }
+  size_t length = std::min(size_t(dword_count) * sizeof(uint32_t), size_t(ring_capacity));
+  auto cmd = MakeCommand<PacketStartCommand>(TraceCommandType::kPacketStart);
+  cmd.base_ptr = base_ptr;
+  cmd.count = uint32_t(length / sizeof(uint32_t));
+  Write(&cmd, sizeof(cmd));
+  // Raw (guest-endian) dwords, continuing from the beginning of the ring if
+  // the packet wraps around its end.
+  size_t first_length = std::min(length, size_t(ring_capacity - offset));
+  Write(ring + offset, first_length);
+  Write(ring, length - first_length);
+}
+
+void TraceWriter::WriteMemoryCommand(TraceCommandType type, uint32_t base_ptr, size_t length,
+                                     const void* host_ptr) {
+  base_ptr &= kPhysicalMemorySize - 1;
+  length = std::min(length, size_t(kPhysicalMemorySize - base_ptr));
+  if (!host_ptr) {
+    host_ptr = membase_ + base_ptr;
+  }
+  auto cmd = MakeCommand<MemoryCommand>(type);
+  cmd.base_ptr = base_ptr;
+  cmd.encoding_format = MemoryEncodingFormat::kNone;
+  cmd.encoded_length = cmd.decoded_length = uint32_t(length);
+  Write(&cmd, sizeof(cmd));
+  Write(host_ptr, length);
+}
+
+void TraceWriter::WriteEdramSnapshot(const void* snapshot) {
+  if (!file_) {
+    return;
+  }
+  auto cmd = MakeCommand<EdramSnapshotCommand>(TraceCommandType::kEdramSnapshot);
+  cmd.encoding_format = MemoryEncodingFormat::kNone;
+  cmd.encoded_length = xenos::kEdramSizeBytes;
+  Write(&cmd, sizeof(cmd));
+  Write(snapshot, xenos::kEdramSizeBytes);
+}
+
+void TraceWriter::WriteEvent(EventCommand::Type event_type) {
+  if (!file_) {
+    return;
+  }
+  auto cmd = MakeCommand<EventCommand>(TraceCommandType::kEvent);
+  cmd.event_type = event_type;
+  Write(&cmd, sizeof(cmd));
+}
+
+void TraceWriter::WriteRegisters(uint32_t first_register, const uint32_t* register_values,
+                                 uint32_t register_count, bool execute_callbacks_on_play) {
+  if (!file_) {
+    return;
+  }
+  auto cmd = MakeCommand<RegistersCommand>(TraceCommandType::kRegisters);
+  cmd.first_register = first_register;
+  cmd.register_count = register_count;
+  cmd.execute_callbacks = execute_callbacks_on_play;
+  cmd.encoding_format = MemoryEncodingFormat::kNone;
+  cmd.encoded_length = uint32_t(sizeof(uint32_t) * register_count);
+  Write(&cmd, sizeof(cmd));
+  Write(register_values, cmd.encoded_length);
+}
+
+void TraceWriter::WriteGammaRamp(const reg::DC_LUT_30_COLOR* gamma_ramp_256_entry_table,
+                                 const reg::DC_LUT_PWL_DATA* gamma_ramp_pwl_rgb,
+                                 uint32_t gamma_ramp_rw_component) {
+  if (!file_) {
+    return;
+  }
+  constexpr uint32_t k256EntryTableLength = sizeof(reg::DC_LUT_30_COLOR) * 256;
+  constexpr uint32_t kPWLLength = sizeof(reg::DC_LUT_PWL_DATA) * 3 * 128;
+  auto cmd = MakeCommand<GammaRampCommand>(TraceCommandType::kGammaRamp);
+  cmd.rw_component = uint8_t(gamma_ramp_rw_component);
+  cmd.encoding_format = MemoryEncodingFormat::kNone;
+  cmd.encoded_length = k256EntryTableLength + kPWLLength;
+  Write(&cmd, sizeof(cmd));
+  Write(gamma_ramp_256_entry_table, k256EntryTableLength);
+  Write(gamma_ramp_pwl_rgb, kPWLLength);
+}
