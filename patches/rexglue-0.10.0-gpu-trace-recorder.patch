+bool CommandProcessor::ExecutePacketTraced(memory::RingBuffer* reader) {
+  // The whole packet is recorded before executing it, so on playback, memory
+  // reads recorded during its execution are applied before it's executed.
+  const uint8_t* ring = reader->buffer();
+  const uint32_t ring_capacity = reader->capacity();
+  const uint32_t packet_offset = reader->read_offset();
+  const uint32_t packet = reader->ReadAndSwap<uint32_t>();
+  const uint32_t packet_type = packet >> 30;
+
+  uint32_t packet_dwords = 1;
+  bool is_swap = false;
+  if (packet) {
+    switch (packet_type) {
+      case 0x00:
+      case 0x03:
+        packet_dwords = 1 + ((packet >> 16) & 0x3FFF) + 1;
+        // Predicated swaps are always skipped.
+        is_swap = packet_type == 0x03 && ((packet >> 8) & 0x7F) == PM4_XE_SWAP && !(packet & 1);
+        break;
+      case 0x01:
+        packet_dwords = 3;
+        break;
+      default:
+        break;
+    }
+  }
+  // Don't record beyond the submitted data for malformed packets.
+  packet_dwords = std::min(packet_dwords, 1 + reader->read_count() / uint32_t(sizeof(uint32_t)));
+  // Rings are always in the guest physical memory.
+  uint32_t packet_ptr = CpuToGpu(uint32_t(ring + packet_offset - memory_->physical_membase()));
+  trace_writer_.WritePacketStart(packet_ptr, ring, ring_capacity, packet_offset, packet_dwords);
+
+  bool result = false;
+  if (!packet) {
+    result = true;
+  } else {
+    if (packet == 0xCDCDCDCD) {
+      REXGPU_WARN("GPU packet is CDCDCDCD - probably read uninitialized memory!");
+    }
+    switch (packet_type) {
+      case 0x00:
+        result = ExecutePacketType0(reader, packet);
+        break;
+      case 0x01:
+        result = ExecutePacketType1(reader, packet);
+        break;
+      case 0x02:
+        result = ExecutePacketType2(reader, packet);
+        break;
+      case 0x03:
+        result = ExecutePacketType3(reader, packet);
+        break;
+      default:
+        assert_unhandled_case(packet_type);
+        break;
+    }
+  }
+
+  trace_writer_.WritePacketEnd();
+  if (is_swap) {
+    OnTracedSwap();
+  }
+  return result;
+}
+
+void CommandProcessor::OnTracedSwap() {
+  if (!trace_writer_.is_open()) {
+    return;
+  }
+  trace_writer_.WriteEvent(EventCommand::Type::kSwap);
+  ++trace_frames_recorded_;
+  if (trace_streaming_) {
+    trace_writer_.Flush();
+  } else if (!trace_frames_remaining_ || !--trace_frames_remaining_) {
+    EndTrace();
+  }
+}
+
+void CommandProcessor::BeginTrace(bool stream) {
+  if (trace_writer_.is_open()) {
+    return;
+  }
+  uint32_t title_id = kernel_state_ ? kernel_state_->title_id() : 0;
+  std::string file_name =
+      stream ? fmt::format("{:08X}_{}_stream.xtr", title_id, GetTraceTimestamp())
+             : fmt::format("{:08X}_{}_frame{}.xtr", title_id, GetTraceTimestamp(),
+                           trace_swap_count_ + 1);
+  if (!trace_writer_.Open(GetTraceDirectory() / file_name, title_id)) {
+    return;
+  }
+  trace_streaming_ = stream;
+  trace_frames_remaining_ =
+      stream ? 0 : uint32_t(std::max(REXCVAR_GET(trace_gpu_frame_count), int32_t(1)));
+  trace_frames_recorded_ = 0;
+  if (stream) {
+    REXGPU_INFO("GPU trace: recording all frames to {}", rex::path_to_utf8(trace_writer_.path()));
+  } else {
+    REXGPU_INFO("GPU trace: recording {} frame(s) to {}", trace_frames_remaining_,
+                rex::path_to_utf8(trace_writer_.path()));
+  }
+  InitializeTrace();
+}
+
+void CommandProcessor::EndTrace() {
+  if (!trace_writer_.is_open()) {
+    return;
+  }
+  bool succeeded = trace_writer_.Close();
+  trace_streaming_ = false;
+  trace_frames_remaining_ = 0;
+  if (succeeded) {
+    std::error_code error_code;
+    uintmax_t file_size = std::filesystem::file_size(trace_writer_.path(), error_code);
+    REXGPU_INFO("GPU trace: wrote {} frame(s), {} MB, to {}", trace_frames_recorded_,
+                error_code ? uintmax_t(0) : (file_size + (uintmax_t(1) << 20) - 1) >> 20,
+                rex::path_to_utf8(trace_writer_.path()));
+  }
+}
+
+void CommandProcessor::InitializeTrace() {
