+void D3D12CommandProcessor::StartSubmissionThread() {
+  if (async_submission_enabled_) {
+    return;
+  }
+  submission_thread_command_list_ = std::make_unique<DeferredCommandList>(*this);
+  submission_thread_exit_ = false;
+  submission_thread_busy_ = false;
+  submission_thread_ = std::thread([this]() { SubmissionThreadMain(); });
+  async_submission_enabled_ = true;
+}
+
+void D3D12CommandProcessor::StopSubmissionThread() {
+  if (!async_submission_enabled_) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(submission_mutex_);
+    submission_thread_exit_ = true;
+  }
+  submission_cond_.notify_all();
+  if (submission_thread_.joinable()) {
+    submission_thread_.join();
+  }
+  async_submission_enabled_ = false;
+  submission_jobs_.clear();
+  submission_free_streams_.clear();
+  submission_thread_command_list_.reset();
+}
+
+void D3D12CommandProcessor::AwaitSubmissionThreadIdle() {
+  std::unique_lock<std::mutex> lock(submission_mutex_);
+  submission_idle_cond_.wait(
+      lock, [this]() { return submission_jobs_.empty() && !submission_thread_busy_; });
+}
+
+void D3D12CommandProcessor::SubmissionThreadMain() {
+  ID3D12CommandQueue* direct_queue = GetD3D12Provider().GetDirectQueue();
+  while (true) {
+    SubmissionJob job;
+    {
+      std::unique_lock<std::mutex> lock(submission_mutex_);
+      submission_cond_.wait(
+          lock, [this]() { return submission_thread_exit_ || !submission_jobs_.empty(); });
+      if (submission_jobs_.empty()) {
+        // Exit requested and everything has been submitted.
+        break;
+      }
+      job = std::move(submission_jobs_.front());
+      submission_jobs_.pop_front();
+      submission_thread_busy_ = true;
+    }
+    job.command_allocator->Reset();
+    command_list_->Reset(job.command_allocator, nullptr);
+    submission_thread_command_list_->SwapCommandStream(job.command_stream);
+    submission_thread_command_list_->Execute(command_list_, command_list_1_);
+    command_list_->Close();
+    ID3D12CommandList* execute_command_lists[] = {command_list_};
+    direct_queue->ExecuteCommandLists(1, execute_command_lists);
+    direct_queue->Signal(submission_fence_, job.fence_value);
+    submission_thread_command_list_->SwapCommandStream(job.command_stream);
+    job.command_stream.clear();
+    {
+      std::lock_guard<std::mutex> lock(submission_mutex_);
+      submission_free_streams_.push_back(std::move(job.command_stream));
+      submission_thread_busy_ = false;
+      if (submission_jobs_.empty()) {
+        submission_idle_cond_.notify_all();
+      }
+    }
+  }
+}
