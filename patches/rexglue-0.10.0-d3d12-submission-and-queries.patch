+void D3D12CommandProcessor::PrepareForWait() {
+  // The command processor is about to wait for the guest (out of commands, or
+  // WAIT_REG_MEM). The guest may be waiting for an occlusion query result, so
+  // deliver pending ones now rather than whenever the next frame completes.
+  ProcessPendingOcclusionQueries(true);
+  CommandProcessor::PrepareForWait();
+}
