+void D3D12CommandProcessor::ProcessPendingOcclusionQueries(bool force) {
+  if (pending_occlusion_queries_.empty()) {
+    return;
+  }
+  if (force) {
+    // The latest pending query may still be in the open submission.
+    if (submission_open_ && pending_occlusion_queries_.back().submission >= submission_current_ &&
+        CanEndSubmissionImmediately()) {
+      EndSubmission(false);
+    }
+    uint64_t await_submission = pending_occlusion_queries_.back().submission;
+    if (await_submission < submission_current_) {
+      CheckSubmissionFence(await_submission);
+    }
+  } else {
+    CheckSubmissionFence(0);
+  }
+  while (!pending_occlusion_queries_.empty()) {
+    const PendingOcclusionQuery& query = pending_occlusion_queries_.front();
+    if (query.submission > submission_completed_ || !occlusion_query_readback_mapping_) {
+      break;
+    }
+    auto* sample_counts =
+        memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(query.sample_count_address);
+    if (sample_counts) {
+      WriteGuestOcclusionResult(
+          sample_counts,
+          NormalizeOcclusionSamples(occlusion_query_readback_mapping_[query.host_index]));
+    }
+    pending_occlusion_queries_.pop_front();
+  }
+}
