+namespace {
+std::string SerializeStringValue(std::string value) {
+  const toml::value<std::string> node{std::move(value)};
+  std::ostringstream stream;
+  // Keep one basic string per line; TOML owns escaping for paths, quotes,
+  // control characters and Unicode instead of writing an unescaped literal.
+  stream << toml::toml_formatter{node, toml::format_flags::allow_unicode_strings};
+  return stream.str();
+}
+}  // namespace
