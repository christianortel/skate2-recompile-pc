+// Opt-in, process-local observations only. Never latch, synthesize or consume
+// input. The sole MnK device shares these counters across its caller threads.
+struct MnkDiagnostics {
+  std::atomic<uint64_t> state_polls{0};
+  std::atomic<uint64_t> keystroke_polls{0};
+  std::mutex mutex;
+  uint32_t key_records = 0;
+  uint32_t state_records = 0;
+  uint64_t previous_event_poll = 0;
+  uint16_t previous_buttons = 0;
+  uint32_t previous_gates = 0;
+  bool have_state = false;
+};
+MnkDiagnostics input_diagnostics;
+
+int64_t DiagnosticTimeUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+bool IsDiagnosticKey(rex::ui::VirtualKey key) {
+  return key == rex::ui::VirtualKey::kX || key == rex::ui::VirtualKey::kReturn ||
+         key == rex::ui::VirtualKey::kSpace;
+}
+
+void TraceMnkKey(const rex::ui::KeyEvent& e, bool down, bool enabled, bool focused,
+                 bool active, bool applied) {
+  if (!IsDiagnosticKey(e.virtual_key()))
+    return;
+  auto& diag = input_diagnostics;
+  std::lock_guard lock(diag.mutex);
+  if (diag.key_records >= 32)
+    return;
+  const auto polls = diag.state_polls.load(std::memory_order_relaxed);
+  const uint8_t modifiers = (e.is_shift_pressed() ? kModShift : 0) |
+                            (e.is_ctrl_pressed() ? kModCtrl : 0) |
+                            (e.is_alt_pressed() ? kModAlt : 0);
+  REXLOG_INFO("[input_diag] key #{}/32 mono_us={} vk={} down={} applied={} "
+              "enabled={} focus={} active={} mods={} prev_state={} "
+              "state_polls_entered={} polls_since_event={}",
+              ++diag.key_records, DiagnosticTimeUs(), static_cast<uint16_t>(e.virtual_key()),
+              down, applied, enabled, focused, active, modifiers, e.prev_state(),
+              polls, polls - diag.previous_event_poll);
+  diag.previous_event_poll = polls;
+}
+
+void TraceMnkState(uint64_t poll, bool enabled, bool valid_device, bool focused,
+                   int active, uint16_t buttons) {
+  auto& diag = input_diagnostics;
+  std::lock_guard lock(diag.mutex);
+  // Only the two diagnostic gamepad buttons are recorded, never other keys.
+  buttons &= X_INPUT_GAMEPAD_START | X_INPUT_GAMEPAD_A;
+  const uint32_t gates = uint32_t(enabled) | (uint32_t(valid_device) << 1) |
+                         (uint32_t(focused) << 2) | (uint32_t(active + 1) << 3);
+  const bool changed = !diag.have_state || buttons != diag.previous_buttons ||
+                       gates != diag.previous_gates;
+  diag.have_state = true;
+  diag.previous_buttons = buttons;
+  diag.previous_gates = gates;
+  if (diag.state_records >= 64 || (poll > 8 && !changed))
+    return;
+  REXLOG_INFO("[input_diag] state #{}/64 mono_us={} poll={} enabled={} "
+              "valid_device={} focus={} active={} start_a=0x{:04X}",
+              ++diag.state_records, DiagnosticTimeUs(), poll, enabled,
+              valid_device, focused, active, buttons);
+}
+
+void TraceMnkKeystrokePoll(uint64_t poll, bool enabled, bool valid_device) {
+  auto& diag = input_diagnostics;
+  std::lock_guard lock(diag.mutex);
+  // Shares the state-record budget; observes API use, never queue contents.
+  if (poll > 8 || diag.state_records >= 64)
+    return;
+  REXLOG_INFO("[input_diag] keystroke #{}/64 mono_us={} poll={} enabled={} valid_device={}",
+              ++diag.state_records, DiagnosticTimeUs(), poll, enabled, valid_device);
+}
+
