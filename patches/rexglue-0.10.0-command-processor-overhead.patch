+// High-frequency counters incremented on a single thread (the GPU command
+// processor) are accumulated thread-locally and published in bulk right before
+// the per-frame snapshot, which is taken on that same thread in Profiler::Flip.
+// This avoids an atomic operation on shared cache lines for every draw and
+// texture lookup.
+struct LocalCounterBatch {
+  int64_t values[static_cast<size_t>(CounterId::kCount)] = {};
+  bool dirty = false;
+};
+inline thread_local LocalCounterBatch g_local_counter_batch;
+inline void AddLocalCounter(CounterId id, int64_t delta) {
+  g_local_counter_batch.values[static_cast<size_t>(id)] += delta;
+  g_local_counter_batch.dirty = true;
+}
+inline void FlushLocalCounters() {
+  LocalCounterBatch& batch = g_local_counter_batch;
+  if (!batch.dirty) {
+    return;
+  }
+  for (size_t i = 0; i < static_cast<size_t>(CounterId::kCount); ++i) {
+    if (batch.values[i]) {
+      IncrementCounter(static_cast<CounterId>(i), batch.values[i]);
+      batch.values[i] = 0;
+    }
+  }
+  batch.dirty = false;
+}
+
 // Snapshot current values into the read buffer and zero the live counters.
 // Called once per frame by Profiler::Flip().
 void ResetFrameCounters();
