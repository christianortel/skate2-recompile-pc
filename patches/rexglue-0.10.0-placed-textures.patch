+bool D3D12TextureCache::AllocateTextureHeapBlock(uint64_t size, uint64_t alignment,
+                                                 TextureHeapBlock& block_out) {
+  if (!size || size > kTextureHeapSize) {
+    return false;
+  }
+  alignment = std::max(alignment, uint64_t(D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT));
+  auto try_heap = [&](uint32_t heap_index) -> bool {
+    std::map<uint64_t, uint64_t>& free_ranges = texture_heaps_[heap_index].free_ranges;
+    for (auto it = free_ranges.begin(); it != free_ranges.end(); ++it) {
+      uint64_t range_start = it->first;
+      uint64_t range_end = it->first + it->second;
+      uint64_t block_start = (range_start + alignment - 1) & ~(alignment - 1);
+      if (block_start + size > range_end) {
+        continue;
+      }
+      free_ranges.erase(it);
+      if (block_start > range_start) {
+        free_ranges.emplace(range_start, block_start - range_start);
+      }
+      if (block_start + size < range_end) {
+        free_ranges.emplace(block_start + size, range_end - (block_start + size));
+      }
+      block_out.heap_index = heap_index;
+      block_out.offset = block_start;
+      block_out.size = size;
+      return true;
+    }
+    return false;
+  };
+  for (uint32_t i = 0; i < uint32_t(texture_heaps_.size()); ++i) {
+    if (try_heap(i)) {
+      return true;
+    }
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  D3D12_HEAP_DESC heap_desc = {};
+  heap_desc.SizeInBytes = kTextureHeapSize;
+  heap_desc.Properties = ui::d3d12::util::kHeapPropertiesDefault;
+  heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+  heap_desc.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES |
+                    provider.GetHeapFlagCreateNotZeroed();
+  TextureHeap texture_heap;
+  if (FAILED(provider.GetDevice()->CreateHeap(&heap_desc, IID_PPV_ARGS(&texture_heap.heap)))) {
+    return false;
+  }
+  texture_heap.free_ranges.emplace(0, kTextureHeapSize);
+  texture_heaps_.push_back(std::move(texture_heap));
+  return try_heap(uint32_t(texture_heaps_.size() - 1));
+}
+
+void D3D12TextureCache::FreeTextureHeapBlock(const TextureHeapBlock& block) {
+  if (block.heap_index >= texture_heaps_.size() || !block.size) {
+    return;
+  }
+  std::map<uint64_t, uint64_t>& free_ranges = texture_heaps_[block.heap_index].free_ranges;
+  uint64_t start = block.offset;
+  uint64_t end = block.offset + block.size;
+  // Merge with the following free range.
+  auto next = free_ranges.lower_bound(start);
+  if (next != free_ranges.end() && next->first == end) {
+    end += next->second;
+    next = free_ranges.erase(next);
+  }
+  // Merge with the preceding free range.
+  if (next != free_ranges.begin()) {
+    auto previous = std::prev(next);
+    if (previous->first + previous->second == start) {
+      start = previous->first;
+      free_ranges.erase(previous);
+    }
+  }
+  free_ranges.emplace(start, end - start);
 }
 
